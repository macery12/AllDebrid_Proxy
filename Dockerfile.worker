FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Tell Playwright (and Chromium) to use a fixed, world-readable path so the
# browser installed by root is found when the process runs as appuser.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Virtual display for headless=False Chromium inside the container
ENV DISPLAY=:99

# Create a non-root user/group with UID/GID 1000 to match aria2 (PUID=1000)
RUN groupadd -g 1000 appuser && useradd -u 1000 -g 1000 -m -s /bin/bash appuser

# System dependencies required by Playwright's Chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libasound2 libpango-1.0-0 libpangocairo-1.0-0 \
    libcairo2 libx11-6 libx11-xcb1 libxcb1 libxext6 fonts-liberation \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright's Chromium into /ms-playwright (as root) then open
# permissions so appuser can execute the browser at runtime.
RUN playwright install chromium \
    && chmod -R o+rx /ms-playwright

COPY app app
COPY worker worker
COPY Scraper Scraper

# Hand ownership of app files to appuser before dropping privileges
RUN chown -R appuser:appuser /app

USER appuser

CMD ["sh", "-c", "Xvfb :99 -screen 0 1280x720x24 & python -m worker.worker"]
